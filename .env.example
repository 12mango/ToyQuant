# The credentials, as a template -- copy it to `.env` (or to `secrets/okx-demo.env`, which is ignored too) and fill in
# the real values there.
#
# Nothing in this file is a key. The values are placeholders, and the names are the ones the relay reads through
# `VenueCredentials.from_environment`, so a file that carries a real key is a file that must never be tracked: `.env`,
# `.env.*` (except this example) and `secrets/` are all in `.gitignore`, and `tools/export/bundle.py` reads `git ls-files`,
# so an ignored file cannot even leak into a reviewer's copy.
#
#   set -a; . .env; set +a      # load them into the shell the relay runs in
#   or: EnvironmentFile=/etc/toyquant/live.env in the systemd unit

# The demo venue's key, its secret and the passphrase the account was created with. A key pasted into a command line
# reaches every recording the run writes; that is why they are read from the environment and nowhere else.
OKX_API_KEY=replace-with-the-demo-key
OKX_API_SECRET=replace-with-the-demo-secret
OKX_PASSPHRASE=replace-with-the-demo-passphrase

# Where the order leg is pointed. Empty keeps the demo endpoint the relay defaults to.
OKX_ORDER_URL=

# Optional: the relay's own knobs, so the unit file does not carry a second copy of them.
RELAY_MARKET_LISTEN=127.0.0.1:8765
RELAY_ORDER_LISTEN=127.0.0.1:8766
RELAY_INSTRUMENT=BTC-USDT-SWAP
