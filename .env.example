# The credentials and the seat, as a template -- copy it to `/etc/toyquant/live.env` (or `.env`, both ignored) and fill
# in the real values there.
#
# Nothing in this file is a key. The names below are the ones the tools actually read, and they are the tools' own names
# rather than the venue's: `VenueCredentials.from_environment` reads `TOYQUANT_API_KEY`, `TOYQUANT_API_SECRET` and
# `TOYQUANT_PASSPHRASE` (ADR 0005 decision 3 -- the engine's parser has no credential flag, so a key can never reach a
# command line, a recording or a `journalctl` line). A file carrying a real key must never be tracked: `.env`, `.env.*`
# (except this example), `secrets/` and `private/` are all in `.gitignore`, and `tools/export/bundle.py` reads
# `git ls-files`, so an ignored file cannot even leak into a reviewer's copy.
#
#   set -a; . /etc/toyquant/live.env; set +a     # into the shell the relay runs in
#   or: EnvironmentFile=/etc/toyquant/live.env   # in both systemd units, which is how a host runs it
#
# `sudoedit /etc/toyquant/live.env`, mode 0640, owner root:toyquant.

# --- the three credentials the private channel needs (the relay refuses, naming whichever is missing) ---
TOYQUANT_API_KEY=replace-with-the-api-key
TOYQUANT_API_SECRET=replace-with-the-api-secret
TOYQUANT_PASSPHRASE=replace-with-the-passphrase

# --- the seat: the instrument and its venue facts. The relay reads these as its *flag defaults*, which is why neither
# unit file carries a symbol or an endpoint. `python3 tools/live/okx_probe.py spec <inst>` prints the four numbers from
# the venue itself, because a copied ctVal is how a size becomes a hundred times what it should be. ---
RELAY_INSTRUMENT=BTC-USDT-SWAP
RELAY_CONTRACT_SIZE=0.01        # the venue's ctVal: one contract is this much of the coin
RELAY_TICK_SIZE=0.1             # the venue's tickSz
RELAY_LOT_SIZE=1                # the venue's lotSz, in contracts
RELAY_QUANTITY_SCALE=1000000    # engine units per one unit of the coin; the engine's own figure
RELAY_ORDER_INST_CODE=          # the venue's instIdCode, which its newer order operation requires

# --- where the relay's two sockets listen. Both are on the same host and neither is a venue endpoint. ---
RELAY_MARKET_LISTEN=127.0.0.1:8765
RELAY_ORDER_LISTEN=127.0.0.1:8766
RELAY_VENUE=wss://ws.okx.com:8443/ws/v5/public

# --- the order leg's environment. The demo host refuses a placement with no `x-simulated-trading` header and the live
# host refuses one that carries it, so these three lines are the difference between a demonstration and a position. ---
RELAY_ORDER_VENUE=wss://wspap.okx.com:443/ws/v5/private?brokerId=9999
RELAY_ORDER_REST=https://www.okx.com
RELAY_ORDER_LIVE=0
# Once a funded key exists and live.yaml's risk block says what the account may lose, the live three are:
#   RELAY_ORDER_VENUE=wss://ws.okx.com:8443/ws/v5/private
#   RELAY_ORDER_REST=https://www.okx.com
#   RELAY_ORDER_LIVE=1
# They are not interchangeable: a demo key on the live host answers 401, and a live key with RELAY_ORDER_LIVE=0 places a
# demo order that never reaches the market.
