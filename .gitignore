# --------------------------------------------------
# C++ build artifacts / executables / shared and static libraries
# --------------------------------------------------
build/
out/
bin/
*.o
*.obj
*.so
*.dylib
*.a
*.lib
*.dll
*.exe
*.out

# --------------------------------------------------
# CMake-generated temporary files
# --------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.cmake
!CMakeLists.txt

# MkDocs-generated site; published as a Pages artifact by GitHub Actions
site/

# --------------------------------------------------
# Editors and IDEs (keep shared VS Code configuration files)
# --------------------------------------------------
# Visual Studio cache and personal configuration
.vs/
*.user
*.suo

# JetBrains / Sublime
.idea/
*.sublime-workspace
*.sublime-project

# VS Code: ignore local and cache files while keeping shared configuration
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# --------------------------------------------------
# Runtime and backtest logs and temporary data
# --------------------------------------------------
# Keep the logs directory in Git while ignoring individual .log files
logs/*
!logs/.gitkeep

# Intermediate trading records generated by backtest or live runs
data/orders.csv
data/trades.csv
data/runtime/*
!data/runtime/.gitkeep

# Large L2 market data snapshots and incremental feeds
data/v2/



# Visualization reports: keep the README example image and ignore other outputs
reports/*
!reports/synthetic_ticks_optimized.png

# --------------------------------------------------
# Local credentials: never committed, never in a run's [Mode] line
# --------------------------------------------------
# API keys and passphrases live in `secrets/`, which is ignored on purpose: a key in a tracked file is a key in
# the history, and a command line that carries one reaches every recording the run writes. Load them into a shell
# with `set -a; . secrets/okx-demo.env; set +a` and let the tools read the environment.
secrets/
.env
.env.*
!.env.example

# --------------------------------------------------
# Where the sync writes: a machine-local path, never a repository fact
# --------------------------------------------------
# `tools/export/push_windows.sh` reads this file for the Windows folder a Drive client uploads from. It is ignored
# because the path is the machine's -- a public repository has no business carrying `G:\...` -- and because an empty or
# absent file is what makes the sync fail loudly instead of writing somewhere plausible.
.drive-target

# General system temporary files and editor caches
*.log
*.tmp
*.swp
*~
__pycache__/
.venv/
.DS_Store
Thumbs.db