# The SMTP settings `deploy/notify.py` reads when a unit fails. This file is a template: copy it to
# `/etc/toyquant/notify.env`, which is ignored, and fill in the six names. Without it every failure is still in the
# journal and the notifier says so instead of pretending to have mailed anybody.
#
#   sudo install -m 0640 -g toyquant deploy/notify.env.example /etc/toyquant/notify.env
#   sudoedit /etc/toyquant/notify.env
#   python3 deploy/notify.py --unit toyquant-live --dry-run      # the mail, printed instead of sent
#
# Port 587 is a submission port (STARTTLS), 465 is implicit TLS, and anything else is tried as STARTTLS. SMTP_USER may be
# empty for a relay that authenticates by network; SMTP_PASS is a credential like the venue's and belongs nowhere else.
SMTP_HOST=replace-with-the-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-the-smtp-user
SMTP_PASS=replace-with-the-smtp-password
SMTP_FROM=replace-with-the-sender-address
NOTIFY_TO=replace-with-the-operator-address
