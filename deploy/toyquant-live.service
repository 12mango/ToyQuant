[Unit]
Description=ToyQuant live session (relay and engine)
# Five failures in five minutes stops the unit and leaves it red rather than restarting forever: the first deploy to a
# real host crash-looped 35 times (SIGILL from a `-march=native` build) while the health check was reading "activating".
StartLimitIntervalSec=300
StartLimitBurst=5
# A unit that stops is a session that stopped, and nobody watches a journal: the notifier names the unit, the host, the
# four properties that say how it ended and the tail of its journal. `oneshot` and unconfigured-safe -- without
# /etc/toyquant/notify.env it says so and exits 0, because a notifier that fails is a second failure on top of the first.
OnFailure=toyquant-notify@%n.service
# The engine is restarted by a deploy, so the unit has to be up before it and stop after it: the relay dies with the engine
# on the same signal, and an order left resting at the venue is the failure this file's shutdown path exists to prevent.
After=network-online.target
Wants=network-online.target
# The relay is what the two sockets below are: the engine reads market data from it and sends orders to it, so it starts
# first and stops last -- and `Requires=` rather than `Wants=`, because an engine without a relay is a session that dials
# two closed ports, fails, and is restarted by systemd until the start limit stops it. A unit that cannot start its
# dependency should not start at all.
After=toyquant-relay.service
Requires=toyquant-relay.service
# systemd gives the session ten seconds to finish its cancels; the engine's own deadline is the same number, so the unit
# stops waiting at the same moment the session stops trying. Past it, SIGKILL -- a session that cannot cancel is one that
# must be restarted and reconciled, not one that should live.

[Service]
Type=simple
# An unprivileged account, created by `deploy/bootstrap_server.sh`: a bug in the quote loop must not be a bug in the host.
User=toyquant
Group=toyquant
# The credentials are a file, never a unit field: `systemctl cat` is readable by every local user, and a key in it is a key
# in `journalctl`. The file is the operator's, at a path the bootstrap seeds from the template.
EnvironmentFile=-/etc/toyquant/live.env
Environment=PYTHONUNBUFFERED=1
# The configuration is read from a file beside the credentials, which is ignored: the command line carries no symbol and
# no size. `--flags` turns that file into the engine's arguments, in the order `ws` reads them.
WorkingDirectory=/opt/toyquant
# The configuration is checked before anything else runs: `live_config.py --check` refuses a file by name (an unknown key,
# a venue endpoint without `engine.live_orders`, a switch without its endpoint), and without this line that refusal lands
# in a command substitution -- the engine is invoked with no arguments, prints its usage and exits 1, which reads like an
# engine fault and is a configuration one. Measured 2026-11-27: the report showed `ExecMainStatus=1` and `MainPID=0` while
# the sentence that explained it was in `live_config.py`'s mouth.
ExecStartPre=/bin/bash -c 'python3 /opt/toyquant/tools/live/live_config.py --check /etc/toyquant/live.yaml'
# The relay binds its two sockets a moment after systemd considers it started, and the engine connects exactly once at
# startup -- so without this wait the first start of the pair races and the engine exits on a refused connection, which
# systemd then restarts forever. **Both** addresses are waited for: 8765 is where the book comes from and 8766 is where an
# order goes. The wait reads the listening table rather than connecting: a probe connection would be *accepted* by the
# relay (its accept loop takes one client) and the handshake would fail, killing the relay.
#
# It is a script and not a `/bin/bash -c '...'` one-liner because systemd parses this line for escapes: measured
# 2026-11-27, the regex's `\.` reached bash as a bare dot and every start logged `Ignoring unknown escape sequences`,
# while the `$1` and `$)` of a shell function in the same line depend on two parsers agreeing about quoting. A path and
# two arguments have neither problem, and the script can be run and read on its own.
ExecStartPre=/bin/bash /opt/toyquant/deploy/wait_for_ports.sh 127.0.0.1:8765 127.0.0.1:8766
# The flags are captured and checked before the engine starts: an empty substitution would call `toy_quant ws` with no
# endpoint, symbol or strategy, and the engine answers with its full usage text -- which reads like an engine fault and is a
# configuration one, buried under forty lines of help. Measured 2026-11-27, twice. The `--check` above catches a refused
# file; this catches everything else, and either way the reason is the first thing in the journal rather than the last.
ExecStart=/bin/bash -c 'flags=$(python3 /opt/toyquant/tools/live/live_config.py --flags /etc/toyquant/live.yaml) || { echo "live_config.py refused /etc/toyquant/live.yaml (its own message is above)" >&2; exit 1; }; set -- $flags; if [ $# -lt 3 ]; then echo "live_config.py emitted $# argument(s): ws needs at least the endpoint, the symbol and the strategy" >&2; exit 1; fi; exec /opt/toyquant/toy_quant ws "$@"'
# "No news is good news" needs a baseline: one line when the session comes up, so a silent week is a known silence rather
# than an unknown one. `|| true` means a mail failure never fails the unit -- the session is what matters, and the notifier
# says in the journal why it could not send. The five attached lines may be empty on a fast start (`Type=simple` reports
# the unit up before the engine prints), which is why the subject says what happened rather than the body.
ExecStartPost=/bin/bash -c 'python3 /opt/toyquant/deploy/notify.py --unit toyquant-live --event started --lines 5 || true'
# The engine gets 10 s to finish its cancels, and `--close-out` then runs on the same signal: the exit cancels the
# remaining quotes, drains them and waits up to a second for its own fill report, so a unit that gave up at the engine's
# own deadline would SIGKILL a session between the cancels and the close -- the position left open after a run that
# believed it had flattened. 25 s is the 10 s sweep plus that close-out and a margin. `.clinerules` and
# `check_deploy.py`'s fifth rule hold the relation: a unit that stops waiting before the engine does is the defect.
KillSignal=SIGTERM
TimeoutStopSec=25
Restart=on-failure
RestartSec=5
# One session a host: two processes quoting the same instrument against one account is a position neither of them sees.
# The snapshot is what the second one would reconcile from, and it is written by the first.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/toyquant/data/runtime /opt/toyquant/logs

[Install]
WantedBy=multi-user.target
