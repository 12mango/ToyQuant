[Unit]
Description=ToyQuant live session (relay and engine)
# Five failures in five minutes stops the unit and leaves it red rather than restarting forever: the first deploy to a
# real host crash-looped 35 times (SIGILL from a `-march=native` build) while the health check was reading "activating".
StartLimitIntervalSec=300
StartLimitBurst=5
# The engine is restarted by a deploy, so the unit has to be up before it and stop after it: the relay dies with the engine
# on the same signal, and an order left resting at the venue is the failure this file's shutdown path exists to prevent.
After=network-online.target
Wants=network-online.target
# The relay is what the two sockets below are: the engine reads market data from it and sends orders to it, so it starts
# first and stops last.
After=toyquant-relay.service
Wants=toyquant-relay.service
# systemd gives the session ten seconds to finish its cancels; the engine's own deadline is the same number, so the unit
# stops waiting at the same moment the session stops trying. Past it, SIGKILL -- a session that cannot cancel is one that
# must be restarted and reconciled, not one that should live.

[Service]
Type=simple
# An unprivileged account, created by `deploy/bootstrap_server.sh`: a bug in the quote loop must not be a bug in the host.
User=toyquant
Group=toyquant
# The credentials are a file, never a unit field: `systemctl cat` is readable by every local user, and a key in it is a key
# in `journalctl`. The file is the operator's, at a path the bootstrap seeds from the template.
EnvironmentFile=-/etc/toyquant/live.env
Environment=PYTHONUNBUFFERED=1
# The configuration is read from a file beside the credentials, which is ignored: the command line carries no symbol and
# no size. `--flags` turns that file into the engine's arguments, in the order `ws` reads them.
WorkingDirectory=/opt/toyquant
ExecStart=/bin/bash -c 'exec /opt/toyquant/toy_quant ws $(python3 /opt/toyquant/tools/live/live_config.py --flags /etc/toyquant/live.yaml)'
# SIGTERM is the signal the session answers with "stop new orders, cancel what is live, confirm zero, exit". The engine's
# own deadline is 10 s (`SessionShutdown`'s `deadline_ms`), and this waits 12: the two numbers move together, and a unit
# that gave up first would SIGKILL a session mid-cancel.
KillSignal=SIGTERM
TimeoutStopSec=12
Restart=on-failure
RestartSec=5
# One session a host: two processes quoting the same instrument against one account is a position neither of them sees.
# The snapshot is what the second one would reconcile from, and it is written by the first.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/toyquant/data/runtime /opt/toyquant/logs

[Install]
WantedBy=multi-user.target
