[Unit]
Description=ToyQuant daily report (one mail: the last day's session, the account and the host)
# The mail is the operator's daily read, so it is a timer rather than a crontab: `systemctl list-timers` shows when the
# next one runs and `journalctl -u toyquant-report` shows the last one, with no second file to keep in step.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=toyquant
Group=toyquant
# The journal is read as the session's own account, which is what systemd-journal membership allows.
SupplementaryGroups=systemd-journal
EnvironmentFile=-/etc/toyquant/live.env
EnvironmentFile=-/etc/toyquant/notify.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/toyquant
ExecStart=/usr/bin/python3 /opt/toyquant/deploy/daily_report.py
TimeoutStartSec=120
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# `ProtectSystem=strict` makes everything read-only but `/dev`, `/proc` and `/sys`, and the ledger row `daily_report.py`
# appends is the report's only write. Measured 2026-11-27, the first live window: without this line the append failed with
# `Read-only file system`, the mail went out without saying so, and the series started empty. The `-` prefix keeps the unit
# startable if the directory is not there yet (the bootstrap creates it and hands it to the service user).
ReadWritePaths=-/opt/toyquant/data/runtime
