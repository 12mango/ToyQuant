[Unit]
Description=ToyQuant daily report timer

[Timer]
# **Five minutes after the close, named in UTC, because the window is.** The session ends itself at 15:30 (`ws_seconds`)
# and writes its `[WIND-DOWN]`, `[PNL]` and `[RECON] at=end` within a second, so the mail at 15:35 (23:35 HKT, 00:35 JST)
# has the whole window -- and it arrives while the operator is still at the desk rather than after midnight. It was 16:15
# (45 minutes of margin that nothing needed). systemd 235 and newer read the zone suffix.
OnCalendar=*-*-* 15:35:00 UTC
# A host that was down at that moment sends the report when it comes back rather than skipping the window, and a
# five-minute jitter keeps a fleet of hosts from mailing at the same second.
Persistent=true
RandomizedDelaySec=300
Unit=toyquant-report.service

[Install]
WantedBy=timers.target
