```mermaid
%%{init: {"theme":"base","themeVariables":{"fontSize":"15px","primaryColor":"#e8f1f8","primaryTextColor":"#10233a","primaryBorderColor":"#2f6fa8","lineColor":"#6b7b8c","textColor":"#10233a","nodeTextColor":"#10233a","titleColor":"#10233a","tertiaryColor":"#eef4fb"}}}%%
%% Two stacked rows, not one wide row: eleven boxes in a line is unreadable at page width.
%% No edge joins the two subgraphs, and that is the fix for the vertical column this figure used to be: Mermaid
%% ignores `direction` inside a subgraph that has an edge to another one, so the row collapsed into a kebab.
%% The palette is pinned with `theme: base` and explicit text colours, because a classDef `color` alone was overridden
%% by the theme and left grey text on a pale fill.
flowchart TB
    subgraph path["the path"]
        direction LR
        F["feed"] --> B["L2 book"] --> S["strategy"] --> G{"risk gate"} --> V["venue"] --> L["ledger"]
    end

    subgraph loop["the loop"]
        direction LR
        R["record"] --> P["replay"] --> C["[RECON] parity"]
    end

    classDef box fill:#e8f1f8,stroke:#2f6fa8,stroke-width:1.5px,color:#10233a
    classDef gate fill:#fdf3e3,stroke:#b07d1c,stroke-width:1.5px,color:#3b2a06
    classDef good fill:#eaf6ef,stroke:#2c7d54,stroke-width:1.5px,color:#0d2f21
    class F,B,S,V,R,P box
    class G gate
    class L,C good
```
